# Copia este archivo a .env y rellena los valores. Nunca subas .env a git.
PORT=8790
# Sin clave, o con MOCK_AI=1, la IA devuelve respuestas de ejemplo (gratis).
ANTHROPIC_API_KEY=
MOCK_AI=1
# Dirección BCH que recibe los pagos.
MERCHANT_ADDRESS=bitcoincash:qp9d679zvayvudj65nd9zlgezvjplr8g3vea64wad0
# Precios por etapa, en céntimos de dólar (informe 10, kit 50).
PRICE_VALIDATE_CENTS=10
PRICE_BUILD_CENTS=50
# Topes de gasto de IA: por informe (USD), por kit (céntimos) y por día (USD, guardado en la base de datos).
REPORT_CAP_USD=0.08
KIT_SPEND_CAP_CENTS=45
DAILY_CAP_USD=3
# Freno manual: PAUSE=1 rechaza pagos reales; los ejemplos y las muestras siguen funcionando.
PAUSE=
# Escrow "paga solo si entrega": ESCROW y VITE_ESCROW van juntos (los dos 1 o los dos vacíos).
# Con ESCROW=1 hace falta ESCROW_WIF o el servidor no arranca.
ESCROW=
VITE_ESCROW=
ESCROW_WIF=
# Detrás de un proxy (Render): cuántos saltos de X-Forwarded-For son nuestros. En producción, 2 por defecto.
TRUST_PROXY_HOPS=
# Base de datos: en local un archivo; en producción Turso.
DATABASE_URL=file:local.db
DATABASE_TOKEN=
